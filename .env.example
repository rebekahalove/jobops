# Root environment selector for local development.
# Copy this file to .env and set APP_ENV to the local environment name.
APP_ENV=dev

# Live model configuration belongs in .env.<APP_ENV> or platform secrets.
# Keep API keys out of this root selector file.
# JOBOPS_LLM_PROVIDER=gemini
# JOBOPS_DEFAULT_MODEL=gemini-2.5-flash
# JOBOPS_CHEAP_MODEL=gemini-2.5-flash-lite
# JOBOPS_LLM_TIMEOUT_SECONDS=60
# GEMINI_API_KEY=replace-me-in-env-dev-or-platform-secrets

# Server-to-server protection for private JobOps API endpoints.
# Set the same value in the frontend server environment and backend API environment.
# Do not use NEXT_PUBLIC_* for this value.
# JOBOPS_INTERNAL_API_KEY=replace-me-with-a-long-random-secret

# Public JobOps URL used in alpha invite emails.
# JOBOPS_APP_BASE_URL=https://jobops.example.com

# JobOps footer build metadata is generated automatically from deployment or git metadata.
# Do not manually maintain NEXT_PUBLIC_JOBOPS_VERSION or NEXT_PUBLIC_JOBOPS_BUILD values.

# Optional SMTP settings for alpha invite emails.
# JOBOPS_SMTP_HOST=smtp.example.com
# JOBOPS_SMTP_PORT=587
# JOBOPS_SMTP_USERNAME=
# RESEND_API_KEY=
# JOBOPS_SMTP_FROM_EMAIL=JobOps <no-reply@example.com>

# Local-only profile intake debugging. Keep raw text artifacts off unless debugging locally.
# JOBOPS_PROFILE_INTAKE_SAVE_ARTIFACTS=false
# JOBOPS_PROFILE_INTAKE_SAVE_RAW_TEXT=false

# Job discovery provider configuration. Provider facts seed the candidate pool;
# the model selects by candidateId and cannot invent saved job facts.
# JOBOPS_JOB_DISCOVERY_PROVIDERS=adzuna,greenhouse
# JOBOPS_JOB_DISCOVERY_ALLOW_PARTIAL_PROVIDER_FAILURES=false
# JOBOPS_JOB_DISCOVERY_RESULTS_PER_PROVIDER=50
# JOBOPS_JOB_DISCOVERY_CANDIDATE_POOL_LIMIT=100
# JOBOPS_JOB_DISCOVERY_SAVE_LIMIT=25
# JOBOPS_JOB_DISCOVERY_COMPANY_CANDIDATE_CAP=10
# JOBOPS_ADZUNA_APP_ID=replace-me-in-env-dev-or-platform-secrets
# JOBOPS_ADZUNA_APP_KEY=replace-me-in-env-dev-or-platform-secrets
# JOBOPS_ADZUNA_COUNTRY=us
# JOBOPS_GREENHOUSE_BOARD_TOKENS=
