# Local development environment values.
# Copy this file to .env.dev and fill in real local secrets.

# Neon Postgres connection string for the dev database.
DATABASE_URL=postgresql://user:password@host.neon.tech/jobops?sslmode=require

# Use mock model behavior until a real provider key is configured.
JOBOPS_LLM_PROVIDER=mock

# Local FastAPI base URL used by the portfolio app when the API is running.
JOBOPS_API_BASE_URL=http://localhost:8000

# Local server-to-server API key for protected FastAPI endpoints.
# Use the same value in the Next.js server env and FastAPI env.
JOBOPS_INTERNAL_API_KEY=replace-with-local-dev-secret

# Public JobOps base URL used in invite emails.
JOBOPS_APP_BASE_URL=http://localhost:3002

# JobOps footer build metadata is generated automatically from deployment or git metadata.
# Do not manually maintain NEXT_PUBLIC_JOBOPS_VERSION or NEXT_PUBLIC_JOBOPS_BUILD values.

# Optional SMTP settings for alpha invite emails. If omitted, invite creation returns an invite URL for manual sending.
# JOBOPS_SMTP_HOST=smtp.example.com
# JOBOPS_SMTP_PORT=587
# JOBOPS_SMTP_USERNAME=
# RESEND_API_KEY=
# JOBOPS_SMTP_FROM_EMAIL=JobOps <no-reply@example.com>

# Optional local-only dashboard auth bypass. Do not set this in production.
# JOBOPS_DASHBOARD_AUTH_DISABLED=true

# Explicit local browser origins allowed to call the FastAPI backend.
JOBOPS_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Gemini API key and model configuration for live local development.
# Leave GEMINI_API_KEY blank in mock mode.
# JOBOPS_LLM_TIMEOUT_SECONDS=60
GEMINI_API_KEY=
# Switch JOBOPS_LLM_PROVIDER to gemini only when a local key is configured.
# JOBOPS_LLM_PROVIDER=gemini
JOBOPS_DEFAULT_MODEL=gemini-2.5-flash
JOBOPS_CHEAP_MODEL=gemini-2.5-flash-lite

# Local-only profile intake debugging artifacts.
# If raw text saving is true, artifacts may include resume/chat content.
JOBOPS_PROFILE_INTAKE_SAVE_ARTIFACTS=false
JOBOPS_PROFILE_INTAKE_SAVE_RAW_TEXT=false

# Optional job discovery providers. Use mock for deterministic local tests, or
# configure live providers plus a live model for provider-backed candidate selection.
# JOBOPS_JOB_DISCOVERY_PROVIDERS=mock
# JOBOPS_JOB_DISCOVERY_PROVIDERS=adzuna,greenhouse
# JOBOPS_JOB_DISCOVERY_ALLOW_PARTIAL_PROVIDER_FAILURES=false
# JOBOPS_JOB_DISCOVERY_RESULTS_PER_PROVIDER=50
# JOBOPS_JOB_DISCOVERY_CANDIDATE_POOL_LIMIT=100
# JOBOPS_JOB_DISCOVERY_SAVE_LIMIT=5
# JOBOPS_JOB_DISCOVERY_COMPANY_CANDIDATE_CAP=10
# JOBOPS_ADZUNA_APP_ID=
# JOBOPS_ADZUNA_APP_KEY=
# JOBOPS_ADZUNA_COUNTRY=us
# JOBOPS_GREENHOUSE_BOARD_TOKENS=
