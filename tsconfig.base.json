{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@jobops/contracts": ["packages/contracts/src/index.ts"],
      "@jobops/model-connector": ["packages/model-connector/src/index.ts"],
      "@jobops/model-connector/server": ["packages/model-connector/src/server.ts"],
      "@jobops/profile": ["packages/profile/src/index.ts"]
    }
  }
}
