# Production values are documented here but should be configured in Render,
# Netlify, Neon, or GitHub Actions rather than committed to the repo.

APP_ENV=prod
DATABASE_URL=postgresql://user:password@host.neon.tech/jobops?sslmode=require
JOBOPS_API_BASE_URL=https://api.example.com
JOBOPS_DEFAULT_CANDIDATE_PROFILE_SLUG=rebekah-love
GEMINI_API_KEY=replace-me-in-platform-secret-store
JOBOPS_LLM_PROVIDER=gemini
JOBOPS_DEFAULT_MODEL=gemini-2.5-flash
JOBOPS_CHEAP_MODEL=gemini-2.5-flash-lite
JOBOPS_PROFILE_INTAKE_SAVE_ARTIFACTS=false
JOBOPS_PROFILE_INTAKE_SAVE_RAW_TEXT=false
