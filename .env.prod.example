# Production values are documented here but should be configured in Render,
# Netlify, Neon, or GitHub Actions rather than committed to the repo.

APP_ENV=prod
DATABASE_URL=postgresql://user:password@host.neon.tech/jobops?sslmode=require
JOBOPS_API_BASE_URL=https://api.example.com
JOBOPS_INTERNAL_API_KEY=replace-with-long-random-secret
JOBOPS_APP_BASE_URL=https://jobops.example.com
JOBOPS_CORS_ORIGINS=https://rebekahalove.dev,https://www.rebekahalove.dev,https://jobops.rebekahalove.dev
# API docs are disabled by default in prod. Set true only when intentionally exposing them.
# JOBOPS_ENABLE_API_DOCS=false
GEMINI_API_KEY=replace-me-in-platform-secret-store
JOBOPS_LLM_PROVIDER=gemini
JOBOPS_DEFAULT_MODEL=gemini-2.5-flash
JOBOPS_CHEAP_MODEL=gemini-2.5-flash-lite
JOBOPS_PROFILE_INTAKE_SAVE_ARTIFACTS=false
JOBOPS_PROFILE_INTAKE_SAVE_RAW_TEXT=false
# Optional invite email settings.
# JOBOPS_SMTP_HOST=smtp.example.com
# JOBOPS_SMTP_PORT=587
# JOBOPS_SMTP_USERNAME=replace-me-in-platform-secret-store
# JOBOPS_SMTP_PASSWORD=replace-me-in-platform-secret-store
# JOBOPS_SMTP_FROM_EMAIL=JobOps <no-reply@example.com>
